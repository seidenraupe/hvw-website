# Hostpoint / Apache — Soft-Launch Historischer Verein Winterthur
#
# Stamm-URL bleibt die Weiterleitung zur bestehenden Vereinswebsite.
# Die öffentliche Programmseite ist entfernt. PDFs liegen unter /dokumente/.

DirectoryIndex index.html

Options -Indexes

<IfModule mod_rewrite.c>
  RewriteEngine On

  # HTTPS erzwingen
  RewriteCond %{HTTPS} !=on
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # Legacy: /vorschau/ → /edit/ (Go-Live-Vorbereitung)
  RewriteRule ^vorschau/?$ /edit/ [L,R=301]
  RewriteRule ^vorschau/(.+)$ /edit/$1 [L,R=301]

  # Stamm (/ und /index.html) → bestehende Website
  RewriteRule ^$ https://www.historischer-verein-winterthur.ch/ [L,R=301]
  RewriteRule ^index\.html$ https://www.historischer-verein-winterthur.ch/ [L,R=301]

  # Öffentliche Programmseite ist gelöscht.
  RewriteRule ^programm/?$ - [G,L]
  RewriteRule ^programm/index\.html$ - [G,L]
  RewriteRule ^programm\.html$ - [G,L]

  # /coucou → /coucou/ (Coucou-JSON-Kontrolle)
  RewriteRule ^coucou$ /coucou/ [L,R=301]

  # /mus → /mus/ (Museum-Schaffen-JSON-Kontrolle)
  RewriteRule ^mus$ /mus/ [L,R=301]

  # PDFs: frühere Pfade → /dokumente/
  RewriteRule ^Statuten\.pdf$ /dokumente/Statuten.pdf [L,R=301]
  RewriteRule ^Sammlungskonzept\.pdf$ /dokumente/Sammlungskonzept.pdf [L,R=301]
  RewriteRule ^Jahresbericht-2025\.pdf$ /dokumente/Jahresbericht-2025.pdf [L,R=301]
  RewriteRule ^JB_2024_final\.pdf$ /dokumente/JB_2024_final.pdf [L,R=301]
  RewriteRule ^programm/Programm\.pdf$ /dokumente/Programm.pdf [L,R=301]
  RewriteRule ^programm/HalbJahresprogramm\.pdf$ /dokumente/Programm.pdf [L,R=301]
  RewriteRule ^programm/HalbJahresprogramm\.json$ /programm/Programm.json [L,R=301]

</IfModule>

<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
