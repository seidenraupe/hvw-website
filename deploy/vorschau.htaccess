# Interne Vorschau — Zugang per E-Mail-Code (kein HTTP-Basic).

DirectoryIndex index.html index.php

Options -Indexes

<IfModule mod_headers.c>
  Header always set X-Robots-Tag "noindex, nofollow, noarchive"
  Header set X-Content-Type-Options "nosniff"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
  <FilesMatch "\.(html|js|css|json)$">
    Header set Cache-Control "no-store, max-age=0"
  </FilesMatch>
</IfModule>

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /vorschau/

  RewriteCond %{HTTPS} !=on
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  RewriteRule ^zugang/lib\.php$ - [F]
  RewriteRule ^zugang/serve\.php$ - [L]
  RewriteRule ^css/ - [L]
  RewriteRule ^js/ - [L]
  RewriteRule ^images/ - [L]

  RewriteRule ^programm/HalbJahresprogramm\.pdf$ programm/Programm.pdf [L,R=301]
  RewriteRule ^programm/HalbJahresprogramm\.json$ programm/Programm.json [L,R=301]

  RewriteRule ^ zugang/serve.php [QSA,L]
</IfModule>
